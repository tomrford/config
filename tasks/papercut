#!/bin/sh
#MISE description="Log addressable friction for later"
#MISE dir="{{cwd}}"
#USAGE arg "<message>" var=#true help="Friction to record"
set -eu

log="$HOME/.agents/PAPERCUTS.md"
mkdir -p "${log%/*}"
[ -f "$log" ] || printf '# Papercuts\n\n' >"$log"

printf '## %s — %s:%s\n\n%s\n\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')" \
  "$(hostname)" \
  "$PWD" \
  "$*" >>"$log"
